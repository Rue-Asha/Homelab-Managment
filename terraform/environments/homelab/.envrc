# Loaded by direnv on entering this directory. Run `direnv allow` once.
#
# The credential file lives OUTSIDE this repo and is never committed:
#
#   install -m 0600 /dev/null ~/.config/homelab/terraform.env
#   cat > ~/.config/homelab/terraform.env <<'EOF'
#   export PROXMOX_VE_ENDPOINT='https://192.168.0.22:8006/'
#   export PROXMOX_VE_API_TOKEN='terraform@pve!<token-id>=<uuid>'
#   EOF
#
# This token is the bootstrap credential for the homelab. It stays outside
# Vault permanently -- Vault runs in an LXC that Terraform provisions using
# this very token, so putting it in Vault would make the system unbootstrappable.
# See design D12.

source_up_if_exists   # inherit ANSIBLE_CONFIG from the repo-root .envrc

dotenv_if_exists ~/.config/homelab/terraform.env

if [ -z "${PROXMOX_VE_API_TOKEN:-}" ]; then
  log_error "PROXMOX_VE_API_TOKEN is unset -- create ~/.config/homelab/terraform.env (mode 0600)."
fi
