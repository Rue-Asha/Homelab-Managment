---
# ansible-lint configuration.
#
# Each entry below is a deliberate scoping decision, not a "shut up the
# linter" hack — keep the reasoning here so future-us can revisit them.
#
# Lives at the repo root, not in ansible/: ansible-lint only discovers its
# config from the working directory upwards, and every command (including the
# pre-commit hook) runs from the root.

exclude_paths:
  # Terraform's provider cache ships its own YAML changelogs.
  - terraform/
  # Generated by Terraform's local_file resource — never hand-edited.
  - ansible/inventory/00-terraform.yml
  - openspec/
  - .claude/

skip_list:
  # A handful of inline expressions blow past yamllint's default 160-char
  # ceiling and are hard to fold without making the YAML worse.
  - yaml[line-length]
