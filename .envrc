# Loaded by direnv at the repo root. Run `direnv allow` once.
#
# Ansible looks for ansible.cfg in the current directory, and it now lives in
# ansible/. Pointing ANSIBLE_CONFIG at it means every ansible command still
# works from the repo root, which is where they belong: the Terraform-backed
# inventory plugin resolves `project_path: terraform/environments/homelab`
# relative to the working directory.
#
# Relative paths inside ansible.cfg (inventory = inventory/, roles_path = ./roles)
# resolve against the config file's own directory, so none of them needed
# rewriting when the tree moved.

export ANSIBLE_CONFIG="${PWD}/ansible/ansible.cfg"
