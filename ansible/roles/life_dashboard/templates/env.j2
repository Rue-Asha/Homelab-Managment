# {{ ansible_managed }}
# Environment for the life-dashboard service (read by the systemd unit).
HOST={{ life_dashboard_host }}
PORT={{ life_dashboard_port }}
NODE_ENV={{ life_dashboard_node_env }}
DATABASE_PATH={{ life_dashboard_db_path }}
# Browser-facing URL of the app (through nginx). SvelteKit's CSRF protection
# rejects all form POSTs whose Origin header does not match this value.
ORIGIN={{ life_dashboard_origin }}
# Directory for uploaded images (module heroes, sidebar mood, note covers).
# Must be writable by the service user and persist across releases.
IMAGES_DIR={{ life_dashboard_images_dir }}
