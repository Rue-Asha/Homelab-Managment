# {{ ansible_managed }}
[Unit]
Description=Party Games web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ partygames_user }}
Group={{ partygames_group }}
WorkingDirectory={{ partygames_current_link }}
EnvironmentFile={{ partygames_env_file }}
ExecStart={{ partygames_node_bin }} {{ partygames_current_link }}/build
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ partygames_data_dir }}

[Install]
WantedBy=multi-user.target
