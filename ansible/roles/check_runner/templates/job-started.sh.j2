#!/bin/sh
# {{ ansible_managed }}
# Runs before every job. Nothing from an earlier job may be left in the
# workspace. The directory is emptied, not removed, because the runner has
# already made it the job's working directory; it does not exist before the
# first job.
if [ -d "{{ item['workspace'] }}" ]; then
  find "{{ item['workspace'] }}" -mindepth 1 -delete
fi
