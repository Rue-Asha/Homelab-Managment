# {{ ansible_managed }}
[Unit]
Description=GitHub Actions runner ({{ check_runner_name }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ check_runner_user }}
Group={{ check_runner_user }}
WorkingDirectory={{ check_runner_dir }}
# runsvc.sh, not run.sh: only runsvc.sh reads .path, which puts the venv's
# tools on the job PATH.
ExecStart={{ check_runner_dir }}/bin/runsvc.sh
# The listener forwards SIGTERM to a running job and waits for it.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=always
RestartSec=10

# Jobs run as this user and must never gain privileges, even via setuid.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
