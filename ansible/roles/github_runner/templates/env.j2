# {{ ansible_managed }}
LANG=C.UTF-8
ANSIBLE_PRIVATE_KEY_FILE={{ github_runner_deploy_key }}
ANSIBLE_VAULT_PASSWORD_FILE={{ github_runner_vault_password_file }}
ANSIBLE_HOST_KEY_CHECKING=True
ANSIBLE_SSH_ARGS=-o UserKnownHostsFile={{ github_runner_known_hosts }} -o ControlMaster=auto -o ControlPersist=60s
