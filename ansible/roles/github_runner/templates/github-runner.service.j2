# {{ ansible_managed }}
[Unit]
Description=GitHub Actions runner ({{ github_runner_name }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ github_runner_user }}
Group={{ github_runner_user }}
WorkingDirectory={{ github_runner_dir }}
ExecStart={{ github_runner_dir }}/run.sh
# The listener forwards SIGTERM to a running job and waits for it.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=always
RestartSec=10

# Jobs run as this user and must never gain privileges, even via setuid.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
